    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\n\nif (!response.ok || !response.result || response.result.length === 0) {\n  return [];\n}\n\nconst lastProcessed = staticData.lastUpdateId || 0;\nconst newUpdates = response.result.filter(u => u.update_id > lastProcessed);\n\nif (newUpdates.length === 0) {\n  return [];\n}\n\nconst lastUpdate = newUpdates[newUpdates.length - 1];\nstaticData.lastUpdateId = lastUpdate.update_id;\n\nconst msg = lastUpdate.message;\nif (!msg || !msg.text) {\n  return [];\n}\n\n// Игнорируем команды (/start, /help и т.д.)\nif (msg.text.startsWith('/')) {\n  return [];\n}\n\nreturn [{\n  json: {\n    text: msg.text,\n    chatId: msg.chat.id,\n    firstName: msg.from.first_name || 'User'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ],
      "id": "4afcdc35-ce8c-4f50-a7fa-907f371c9456",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const llmOutput = $input.first().json.text;\n\nconst firstBrace = llmOutput.indexOf('{');\nconst lastBrace = llmOutput.lastIndexOf('}');\n\nif (firstBrace === -1 || lastBrace === -1) {\n  return [{ json: { category: 'неизвестно', amount: null, summary: 'ошибка парсинга' } }];\n}\n\nconst jsonString = llmOutput.substring(firstBrace, lastBrace + 1);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonString);\n} catch (e) {\n  parsed = { category: 'неизвестно', amount: null, summary: llmOutput.substring(0, 50) };\n}\n\nconst originalCode = $('Code in JavaScript').first().json;\n\nreturn [{\n  json: {\n    category: parsed.category,\n    amount: parsed.amount,\n    summary: parsed.summary,\n    chatId: originalCode.chatId,\n    firstName: originalCode.firstName,\n    originalText: originalCode.text\n  }\n}];"
      },
